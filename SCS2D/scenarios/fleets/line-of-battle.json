    "size": 0.01,
    "spacing": 10,
    "offset": 0.41,
    "angle": 44
  },
  "designs": {
    "Gunship": {
      "formatVersion": 2,
      "name": "Gunship",
      "notes": "A heavy gunship: a bow gun firing a shell an order of magnitude heavier than the corvette's, and a broadside turret on each beam for anything that gets inside it. Twice the corvette's engines move four times its mass, so it is markedly more sluggish — which is the point of having two ships to compare.",
      "doctrine": {
        "targeting": {
          "loyaltyWeight": 60,
          "facingWeight": 60,
          "sightWeight": 20,
          "escortWeight": 10
        },
        "approach": {
          "escortRadii": 10,
          "escort": 0.2,
          "escortMinRadii": 0.9,
          "separation": 400,
          "tolerance": 0.3,
          "ramRadii": 5
        }
      },
      "assemblies": {
        "outrigger": {
          "notes": "An outrigger, holding a small fast-firing multi-barrelled gun clear of the spine. A gun flat against the hull has almost no traverse worth the mass it costs.",
          "modules": [
            {
              "id": 13,
              "kind": "structure",
              "x": 0,
              "y": -1,
              "length": 8,
              "width": 6,
              "thick": true
            },
            {
              "id": 14,
              "kind": "turret",
              "x": 0,
              "y": 5,
              "angle": 90,
              "length": 6,
              "width": 5,
              "barrels": 4,
              "barrelCalibres": 90,
              "traverse": 110.00000000000001,
              "fuse": 0.2,
              "fragments": 10,
              "burstSpeed": 200,
              "main": false,
              "targeting": {
                "preferredMass": 0.1,
                "proximityWeight": 200,
                "armedWeight": 250,
                "mobileWeight": 100,
                "focusWeight": 0,
                "closingWeight": 50,
                "facingWeight": 60,
                "sightWeight": 20,
                "coreWeight": 20,
                "gunWeight": 160
              },
              "notes": "Many narrow barrels rather than one wide one: the same bore budget spent on rate of fire instead of weight of shell. It goes after whatever is small, close and still dangerous while the main battery fights its own weight class — a shell this light is wasted on a capital, and a close-in gun exists for what can still do something rather than for what is already out of the fight. Caring about that is worth more than the whole of its proximity preference, so it passes over a drifting hulk at any range. It also takes no interest in what the ship as a whole is fighting, which leaves each of the pair free to take whichever threat is nearer to it rather than both piling onto one."
            }
          ]
        },
        "mainEngine": {
          "notes": "One of the pair that drives the ship forward.",
          "modules": [
            {
              "id": 15,
              "kind": "engine",
              "x": 4,
              "y": -0.25,
              "angle": 180,
              "length": 4,
              "width": 4.5,
              "nozzle": 0.8889,
              "thick": true
            }
          ]
        },
        "lateral": {
          "notes": "A manoeuvring engine pushing inboard, so its exhaust leaves into clear air rather than into the stub it is bolted to.",
          "modules": [
            {
              "id": 16,
              "kind": "engine",
              "x": 0,
              "y": -1,
              "angle": 90,
              "length": 1,
              "width": 5,
              "barrels": 2,
              "nozzle": 0.4,
              "thick": true
            }
          ]
        },
        "retro": {
          "notes": "Braking thrust, pushing aft.",
          "modules": [
            {
              "id": 17,
              "kind": "engine",
              "x": -1.5,
              "y": 0,
              "angle": 0,
              "length": 1.5,
              "width": 4,
