{
  "formatVersion": 1,
  "name": "Line of Battle",
  "notes": "The capital in the middle, a beam ship and a gun ship on the wings, and a pair of fighters ahead of them — enough of a mix that a doctrine will have something to disagree about.",
  "livery": {
    "base": "#4555c7",
    "highlight": "#841c1c",
