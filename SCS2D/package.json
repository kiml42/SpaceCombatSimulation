{
  "name": "space-combat-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Planar, physics-driven fleet-tactics game. See DESIGN.md.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -p sim && tsc -p . && tsc -p tsconfig.web.json",
    "golden": "tsx scripts/golden.ts",
    "evolve": "tsx scripts/evolve.ts",
    "yardstick": "tsx scripts/yardstick.ts",
    "build": "tsx scripts/build.ts",
    "dev": "tsx scripts/build.ts --watch",
    "sync-fleets": "tsx scripts/syncFleets.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
