{
  "name": "space-combat-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Planar, physics-driven fleet-tactics game. See DESIGN.md.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -p sim && tsc -p . && tsc -p tsconfig.web.json",
    "golden": "tsx scripts/golden.ts",
    "build": "tsx scripts/build.ts",
    "dev": "tsx scripts/build.ts --watch"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
