{
  "name": "space-combat-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "description": "Planar, physics-driven fleet-tactics game. See DESIGN.md.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "node node_modules/typescript7/bin/tsc -p sim && node node_modules/typescript7/bin/tsc -p . && node node_modules/typescript7/bin/tsc -p tsconfig.web.json && node node_modules/typescript7/bin/tsc -p tsconfig.app.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,css}\"",
    "lint": "eslint . && stylelint \"{app,ui,features}/**/*.{css,ts,tsx}\"",
    "golden": "tsx scripts/golden.ts",
    "bench:render": "tsx benchmarks/render.ts",
    "evolve": "tsx scripts/evolve.ts",
    "yardstick": "tsx scripts/yardstick.ts",
    "build": "vite build",
    "dev": "tsx scripts/dev.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "sync-fleets": "tsx scripts/syncFleets.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@linaria/core": "^8.3.0",
    "@linaria/react": "^8.3.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@wyw-in-js/vite": "^2.7.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "postcss-styled-syntax": "^0.7.4",
    "prettier": "3.9.10",
    "storybook": "^10.6.7",
    "storybook-addon-pseudo-states": "^10.6.7",
    "storybook-design-token": "^5.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
